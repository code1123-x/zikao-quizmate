.practice {
  padding-bottom: 80rpx;
}

.topbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.top-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.top-sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.top-pct {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 800;
}

.top-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.exam-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff4e5;
  color: #d97706;
  font-size: 19rpx;
  font-weight: 700;
}

.timer {
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  background: #eef0ff;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.finish-link {
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  background: var(--bad-soft);
  color: var(--bad);
  font-size: 21rpx;
  font-weight: 700;
}

.progress {
  height: 12rpx;
  margin-bottom: 24rpx;
  border-radius: 999rpx;
  background: #e8eaf4;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5b5be0, #8b7bff);
  transition: width 0.25s;
}

.q-card {
  padding: 30rpx;
}

.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.q-source {
  color: var(--muted);
  font-size: 22rpx;
}

.q-stem {
  font-size: 32rpx;
  line-height: 1.7;
  font-weight: 600;
  white-space: pre-wrap;
}

.options {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: #fbfbfe;
}

.option.picked {
  border-color: rgba(79, 70, 229, 0.55);
  background: var(--primary-soft);
}

.option.correct {
  border-color: rgba(22, 163, 74, 0.55);
  background: var(--ok-soft);
}

.option.wrong {
  border-color: rgba(220, 38, 38, 0.45);
  background: var(--bad-soft);
}

.option-key {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef0f8;
  color: var(--muted);
  font-size: 23rpx;
  font-weight: 700;
}

.option.picked .option-key {
  background: var(--primary);
  color: #fff;
}

.option.correct .option-key {
  background: var(--ok);
  color: #fff;
}

.option.wrong .option-key {
  background: var(--bad);
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
}

.unsupported {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f6f7fc;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.written-answer { margin-top: 26rpx; }
.answer-input {
  width: 100%; min-height: 190rpx; padding: 20rpx; box-sizing: border-box;
  border: 1rpx solid var(--line); border-radius: 18rpx; background: #fbfbfe;
  font-size: 28rpx; line-height: 1.65;
}
.reference-toggle { margin-top: 18rpx; color: var(--primary); font-size: 25rpx; font-weight: 700; }
.reference-body {
  margin-top: 14rpx; padding: 22rpx; border-radius: 16rpx; background: #f6f7fc;
  color: #4b5068; font-size: 25rpx; line-height: 1.75; white-space: pre-wrap;
}
.reference-label { display: block; margin: 8rpx 0; color: var(--fg); font-weight: 700; }
.rating-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.rating { margin: 0; padding: 12rpx 18rpx; border-radius: 999rpx; font-size: 23rpx; line-height: 1.5; }
.rating.master { color: #15803d; background: #eafaf0; }
.rating.vague { color: #b45309; background: #fff7e6; }
.rating.none { color: #b91c1c; background: #fdeeee; }

.feedback {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 18rpx;
}

.feedback.ok {
  background: var(--ok-soft);
  border: 1rpx solid rgba(22, 163, 74, 0.2);
}

.feedback.bad {
  background: var(--bad-soft);
  border: 1rpx solid rgba(220, 38, 38, 0.18);
}

.feedback-title {
  font-size: 27rpx;
  font-weight: 700;
}

.feedback.ok .feedback-title {
  color: var(--ok);
}

.feedback.bad .feedback-title {
  color: var(--bad);
}

.feedback-body {
  margin-top: 12rpx;
  color: #4b5068;
  font-size: 25rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.exam-note {
  margin-top: 24rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f8f8fd;
  color: var(--muted);
  font-size: 21rpx;
  text-align: center;
}

.actions {
  margin-top: 30rpx;
}

.finish {
  padding-top: 30rpx;
}

.finish-card {
  padding: 40rpx 32rpx;
  text-align: center;
}

.finish-title {
  font-size: 40rpx;
  font-weight: 800;
}

.finish-ring {
  width: 220rpx;
  height: 220rpx;
  margin: 34rpx auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #ffffff, #f4f3ff);
  border: 12rpx solid #e6e4ff;
}

.finish-pct {
  color: var(--primary);
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.finish-label {
  margin-top: 2rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.finish-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 34rpx;
}

.finish-item {
  flex: 1;
  padding: 22rpx 10rpx;
  border-radius: 18rpx;
  background: #f8f8fd;
}

.finish-num {
  font-size: 38rpx;
  font-weight: 800;
}

.finish-num.ok {
  color: var(--ok);
}

.finish-num.bad {
  color: var(--bad);
}

.finish-key {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.back {
  margin-top: 16rpx;
}
