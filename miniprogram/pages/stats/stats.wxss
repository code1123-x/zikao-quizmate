.stats {
  padding-top: 0;
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.range {
  display: flex;
  gap: 6rpx;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #eef0f7;
}

.tab {
  padding: 9rpx 16rpx;
  border-radius: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
}

.tab.on {
  background: #fff;
  color: var(--primary);
  box-shadow: 0 4rpx 12rpx -8rpx rgba(35, 38, 90, 0.5);
}

.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx 12rpx;
  padding: 30rpx;
}

.metric .n {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.metric .n text {
  font-size: 22rpx;
  margin-left: 2rpx;
}

.metric .n.primary {
  color: var(--primary);
}

.metric .n.warn {
  color: #d97706;
}

.metric .n.bad {
  color: var(--bad);
}

.metric .l {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.bank {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  padding: 24rpx 12rpx;
}

.bcell {
  text-align: center;
}

.bcell b {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.bcell b.bad {
  color: var(--bad);
}

.bcell span {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.chart-card {
  padding: 26rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
}

.small {
  font-size: 21rpx;
}

.chart-scroll {
  width: 100%;
}

.chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  min-width: 100%;
  height: 230rpx;
  padding: 0 2rpx;
}

.bar-slot {
  flex: 1;
  min-width: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar-wrap {
  height: 180rpx;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 22rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: #d9dbff;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-ok {
  width: 100%;
  background: #6d6aec;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
}

.bar-label {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 17rpx;
  white-space: nowrap;
}

.legend {
  display: flex;
  gap: 20rpx;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.primary-bg {
  background: #d9dbff;
}

.ok-bg {
  background: #6d6aec;
}

.subject-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.subject-row:last-child {
  border-bottom: none;
}

.subject-badge {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.subject-main {
  flex: 1;
  min-width: 0;
}

.subject-name {
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subject-sub {
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.subject-pending {
  flex: none;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #fff4e5;
  color: #d97706;
  font-size: 19rpx;
}
.weak-action {
  display: inline-block;
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
}

.type-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 13rpx 0;
}

.type-name {
  width: 92rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.type-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef0f7;
  overflow: hidden;
}

.type-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5b5be0, #8b7bff);
}

.type-stat {
  width: 64rpx;
  text-align: right;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
}

.type-count {
  width: 64rpx;
  text-align: right;
  color: var(--muted);
  font-size: 19rpx;
}
