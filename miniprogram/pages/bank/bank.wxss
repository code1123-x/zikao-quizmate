.bank {
  padding-top: 0;
  padding-bottom: 150rpx;
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.total {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.subject-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 26rpx;
}

.picker-label {
  color: var(--muted);
  font-size: 23rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 480rpx;
  color: var(--primary);
  font-size: 25rpx;
  font-weight: 700;
}

.picker-value text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  color: var(--muted);
  font-size: 22rpx;
}

.search-card {
  padding: 22rpx 24rpx;
}

.search-row {
  display: flex;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fbfbfe;
  font-size: 25rpx;
}

.search-btn {
  flex: none;
  height: 72rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.filters {
  margin-top: 18rpx;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  margin-right: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.filter-chip.on {
  border-color: rgba(79, 70, 229, 0.35);
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 700;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f5fa;
  color: var(--muted);
  font-size: 21rpx;
}

.status-chip.on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 700;
}

.clear {
  margin-left: auto;
  color: var(--primary);
  font-size: 21rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.q {
  padding: 22rpx 24rpx;
}

.q-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.check {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #fff;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.check.on {
  border-color: var(--primary);
  background: var(--primary);
}

.pending {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #fff4e5;
  color: #d97706;
  font-size: 19rpx;
  font-weight: 700;
}

.year {
  margin-left: auto;
  color: var(--muted);
  font-size: 20rpx;
}

.q-stem {
  font-size: 26rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.q-answer {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
}

.q-answer-key {
  flex: none;
  color: var(--muted);
}

.q-answer-val {
  color: var(--ok);
  font-weight: 600;
  word-break: break-all;
}

.q-answer-val.empty {
  color: #d97706;
}

.q-source {
  margin-top: 8rpx;
  color: #a2a7be;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more {
  padding: 28rpx 0;
  text-align: center;
  color: var(--primary);
  font-size: 23rpx;
}

.more.muted {
  color: var(--muted);
}

.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}

.batch-count {
  font-size: 24rpx;
  font-weight: 700;
}

.danger {
  background: var(--bad);
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 18, 40, 0.45);
}

.detail {
  width: 100%;
  height: 86vh;
  display: flex;
  flex-direction: column;
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 16rpx;
}

.detail-close {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f2f8;
  color: var(--muted);
  font-size: 34rpx;
  line-height: 1;
}

.detail-body {
  flex: 1;
  padding: 0 28rpx;
  overflow-y: auto;
}

.detail-stem {
  font-size: 29rpx;
  line-height: 1.7;
  font-weight: 600;
  white-space: pre-wrap;
}

.detail-options {
  margin-top: 18rpx;
}

.detail-option {
  display: flex;
  gap: 10rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
}

.opt-key {
  flex: none;
  width: 40rpx;
  color: var(--primary);
  font-weight: 700;
}

.opt-text {
  flex: 1;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fbfbfe;
  font-size: 25rpx;
  line-height: 1.6;
}

.answer-input {
  min-height: 100rpx;
}

.detail-meta {
  margin: 24rpx 0 30rpx;
  color: #a2a7be;
  font-size: 21rpx;
}

.detail-foot {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
}

.detail-foot .btn {
  flex: 1;
}

.danger-text {
  color: var(--bad);
}
