.cards {
  padding-top: 0;
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.total {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.subject {
  padding: 26rpx;
}

.subject-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.subject-badge {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.subject-copy {
  flex: 1;
  min-width: 0;
}

.subject-name {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subject-sub {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.due {
  color: #d97706;
}

.start {
  flex: none;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
}

.bar {
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #eef0f7;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 999rpx;
}

.subject-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 21rpx;
}

.pct {
  color: var(--primary);
  font-weight: 700;
}
