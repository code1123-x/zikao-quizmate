.login-page {
  min-height: 100vh;
  padding: 120rpx 40rpx 60rpx;
  background:
    radial-gradient(420rpx 420rpx at 90% 0%, rgba(79, 70, 229, 0.16), transparent 70%),
    radial-gradient(360rpx 360rpx at 0% 35%, rgba(14, 165, 233, 0.1), transparent 70%),
    #f6f7fc;
}

.brand {
  text-align: center;
  margin-bottom: 56rpx;
}

.logo {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #5b5be0, #7c6cff);
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  box-shadow: 0 20rpx 40rpx -18rpx rgba(79, 70, 229, 0.65);
}

.brand-name {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.brand-sub {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.checking {
  padding: 80rpx 0;
  text-align: center;
  color: var(--muted);
}

.form-card {
  padding: 34rpx 32rpx;
}

.mode-tabs {
  display: flex;
  gap: 10rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
  border-radius: 18rpx;
  background: #f1f2f8;
}

.mode-tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: var(--muted);
  font-size: 27rpx;
  font-weight: 600;
}

.mode-tab.on {
  background: #fff;
  color: var(--primary);
  box-shadow: 0 6rpx 18rpx -12rpx rgba(35, 38, 90, 0.5);
}

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
}

.input {
  height: 92rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: #fbfbfe;
  font-size: 30rpx;
}

.submit {
  margin-top: 14rpx;
}

.tip {
  margin-top: 22rpx;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}

.foot {
  margin-top: 48rpx;
  text-align: center;
  color: #a2a7be;
  font-size: 23rpx;
}
