.ai {
  padding-top: 0;
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.status.on {
  background: var(--ok-soft);
  color: var(--ok);
}

.status.off {
  background: #fff4e5;
  color: #d97706;
}

.config-tip {
  border-color: #fde3b0;
  background: #fffaf0;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 700;
}

.tip-sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.field-label {
  margin-bottom: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fbfbfe;
  font-size: 26rpx;
  font-weight: 600;
}

.picker-arrow {
  color: var(--muted);
  font-size: 22rpx;
}

.subject-meta {
  display: flex;
  gap: 22rpx;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.start-card {
  margin-top: 0;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  font-size: 26rpx;
  font-weight: 700;
}

.progress-pct {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 800;
}

.progress {
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #eef0f7;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5b5be0, #8b7bff);
  transition: width 0.25s;
}

.progress-msg {
  margin: 10rpx 0 18rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 24rpx 0 14rpx;
}

.status-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef0f7;
  color: var(--muted);
  font-size: 21rpx;
}

.status-chip.on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 700;
}

.apply-all {
  margin-left: auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #4f46e5;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.check {
  padding: 22rpx;
}

.check-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.verdict {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.verdict.bad {
  background: var(--bad-soft);
  color: var(--bad);
}

.verdict.mid {
  background: #fff4e5;
  color: #d97706;
}

.verdict.ok {
  background: var(--ok-soft);
  color: var(--ok);
}

.stem {
  font-size: 26rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.answer-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.answer-cell {
  flex: 1;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #f8f8fd;
}

.answer-key {
  color: var(--muted);
  font-size: 19rpx;
}

.answer-val {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 700;
  word-break: break-all;
}

.answer-val.ai {
  color: var(--primary);
}

.reason {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.65;
}

.check-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.check-actions .mini {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--primary);
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
}

.check-actions .mini::after {
  border: none;
}

.check-actions .mini.ghost {
  background: #f1f2f8;
  color: var(--muted);
}
