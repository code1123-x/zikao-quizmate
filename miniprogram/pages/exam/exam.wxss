.exam-page {
  padding-top: 0;
  padding-bottom: 60rpx;
}

.head {
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fbfbfe;
  font-size: 27rpx;
  font-weight: 600;
}

.picker-arrow {
  color: var(--muted);
  font-size: 22rpx;
}

.subject-meta {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.mode-row {
  display: flex;
  gap: 12rpx;
}

.mode {
  flex: 1;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fbfbfe;
}

.mode.on {
  border-color: rgba(79, 70, 229, 0.4);
  background: var(--primary-soft);
}

.mode-title {
  font-size: 25rpx;
  font-weight: 700;
}

.mode-sub {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: #fbfbfe;
  color: var(--muted);
  font-size: 22rpx;
}

.chip.on {
  border-color: rgba(79, 70, 229, 0.4);
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 700;
}

.duration-label {
  margin-top: 24rpx;
}

.tips {
  margin-top: 0;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 700;
}

.tip-line {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.start {
  margin-top: 26rpx;
}
